# Backend
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=262144
# Persistência. Aceita a URL do Neon como fornecida (postgres:// ou postgresql://).
# Ex. local: postgresql://mission:mission@localhost:5432/mission_architect
DATABASE_URL=
# true para servidores de longa duração; false na Vercel (sem pool local, usar a URL "pooled" do Neon).
DATABASE_POOLING=true

# Integrações externas (backend). Chave em https://api.nasa.gov; nunca use DEMO_KEY em produção.
# Com APP_ENV=production e sem chave, APOD/NeoWs/DONKI respondem "not_configured".
NASA_API_KEY=
NASA_API_BASE_URL=https://api.nasa.gov
EPIC_BASE_URL=https://epic.gsfc.nasa.gov
EONET_BASE_URL=https://eonet.gsfc.nasa.gov
JPL_SSD_API_BASE_URL=https://ssd-api.jpl.nasa.gov
JPL_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
OPEN_NOTIFY_BASE_URL=http://api.open-notify.org
EXTERNAL_TIMEOUT_SECONDS=10
NASA_CACHE_TTL_SECONDS=3600
ISS_UPDATE_INTERVAL_SECONDS=15
EXTERNAL_MAX_STALE_SECONDS=604800

# Frontend (Vite). Vazio = mesma origem (/api), como na Vercel e no proxy de desenvolvimento.
VITE_API_BASE_URL=
VITE_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
